{
  "enabledMcpjsonServers": [
    "fusion"
  ],
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(ls *)",
      "Bash(python tools/whoami.py)",
      "Bash(python tools/whoami.py *)",
      "Bash(python tools/sync.py *)",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(python tools/whoami.py)",
      "PowerShell(python tools/whoami.py *)",
      "PowerShell(python tools/sync.py *)",
      "mcp__fusion"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Read|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/guard_writes.py\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "mcp__fusion__fusion_mcp_(execute|update)",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/fusion_checkpoint.py\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
