{
  "enabledMcpjsonServers": [
    "fusion"
  ],
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(ls *)",
      "PowerShell(Get-ChildItem *)",
      "Bash(python tools/whoami.py)",
      "Bash(python tools/whoami.py --language *)",
      "Bash(python tools/preflight.py)",
      "Bash(python tools/fusion_status.py)",
      "Bash(python tools/sync.py pull)",
      "Bash(python tools/sync.py push *)",
      "PowerShell(python tools/whoami.py)",
      "PowerShell(python tools/whoami.py --language *)",
      "PowerShell(python tools/preflight.py)",
      "PowerShell(python tools/fusion_status.py)",
      "PowerShell(python tools/sync.py pull)",
      "PowerShell(python tools/sync.py push *)",
      "mcp__fusion"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Read|Glob|Grep|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/guard_writes.py\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "mcp__fusion__fusion_mcp_(execute|update|read)",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/fusion_checkpoint.py\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
